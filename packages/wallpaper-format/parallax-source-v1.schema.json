{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingjing.local/schemas/parallax-source-v1.schema.json",
  "title": "4D 固定源包 config.json（导入格式，不是 Android 内部配置）",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "canvas", "sensor", "layers"],
  "properties": {
    "formatVersion": { "const": 1 },
    "canvas": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 512, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 512, "maximum": 4096 }
      }
    },
    "sensor": {
      "type": "object", "additionalProperties": false, "required": ["maxAngle", "smoothing", "strength"],
      "properties": {
        "maxAngle": { "type": "number", "minimum": 5, "maximum": 25 },
        "smoothing": { "type": "number", "minimum": 0.05, "maximum": 0.5 },
        "strength": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    },
    "layers": {
      "type": "array", "minItems": 2, "maxItems": 12,
      "description": "额外校验：index 从 1 连续递增，depth 非递增；最后一层 depth=0、opacity=1、blendMode=normal。文件尺寸/透明度由服务端解码校验。",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["index", "depth", "scale", "opacity", "blendMode"],
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 12 },
          "depth": { "type": "number", "minimum": 0, "maximum": 1 },
          "scale": { "type": "number", "minimum": 1, "maximum": 1.5 },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "blendMode": { "enum": ["normal", "screen", "add"] }
        }
      }
    }
  }
}
