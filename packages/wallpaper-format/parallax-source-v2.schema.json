{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingjing.local/schemas/parallax-source-v2.schema.json",
  "title": "4D 方向与强度源配置（Web 模拟器与 Android 共用）",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "canvas", "motion", "layers"],
  "properties": {
    "formatVersion": { "const": 2 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 512, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 512, "maximum": 4096 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAngle"],
      "properties": {
        "maxAngle": { "type": "number", "minimum": 1, "maximum": 75 }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "description": "按 01 最前景到 NN 最背景排列；index 从 1 连续递增。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "offsetPercent", "direction", "scale", "opacity", "blendMode"],
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 12 },
          "offsetPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "位移强度。100 表示满幅角度时移动对应屏幕轴长的 15%，数值按比例线性换算。"
          },
          "direction": {
            "enum": ["follow", "reverse", "fixed"],
            "description": "follow 跟随、reverse 反向、fixed 固定；0% 强度也不会移动。"
          },
          "scale": { "type": "number", "minimum": 1, "maximum": 1.5 },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "blendMode": { "enum": ["normal", "screen", "add"] }
        }
      }
    }
  }
}
