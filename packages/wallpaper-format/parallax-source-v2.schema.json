{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingjing.local/schemas/parallax-source-v2.schema.json",
  "title": "4D 方向与位移比例源配置（Web 模拟器与 Android 共用）",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "canvas", "motion", "layers"],
  "properties": {
    "formatVersion": { "const": 2 },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 512, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 512, "maximum": 4096 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAngleX", "maxAngleY"],
      "properties": {
        "maxAngleX": { "type": "number", "minimum": 1, "maximum": 75 },
        "maxAngleY": { "type": "number", "minimum": 1, "maximum": 75 }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "description": "按 01 最前景到 NN 最背景排列；index 从 1 连续递增。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "offsetXPercent", "offsetYPercent", "initialOffsetXPercent", "initialOffsetYPercent", "direction", "scale", "opacity", "blendMode"],
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 12 },
          "offsetXPercent": {
            "type": "number",
            "minimum": 0,
            "description": "满幅水平倾斜时相对屏幕宽度的位移百分比；不设置产品上限。"
          },
          "offsetYPercent": {
            "type": "number",
            "minimum": 0,
            "description": "满幅垂直倾斜时相对屏幕高度的位移百分比；不设置产品上限。"
          },
          "initialOffsetXPercent": { "type": "number", "description": "中立姿态的水平位置修正；负数向左，正数向右，100 为一屏宽。" },
          "initialOffsetYPercent": { "type": "number", "description": "中立姿态的垂直位置修正；负数向上，正数向下，100 为一屏高。" },
          "direction": {
            "enum": ["follow", "reverse", "fixed"],
            "description": "follow 跟随、reverse 反向、fixed 固定；0% 强度也不会移动。"
          },
          "scale": { "type": "number", "minimum": 1, "maximum": 1.5 },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "blendMode": { "enum": ["normal", "screen", "add"] }
        }
      }
    }
  }
}
